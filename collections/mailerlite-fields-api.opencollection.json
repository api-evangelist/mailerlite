{
  "opencollection": "1.0.0",
  "info": {
    "name": "MailerLite Automations Fields API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Fields",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List custom fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.mailerlite.com/api/fields"
          },
          "docs": "List custom fields"
        },
        {
          "info": {
            "name": "Create a custom field",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://connect.mailerlite.com/api/fields",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a custom field"
        }
      ]
    }
  ],
  "bundled": true
}